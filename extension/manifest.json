{
  "manifest_version": 3,
  "name": "web-to-api session sync",
  "version": "1.0.0",
  "description": "Sends your logged-in Qwen / Kimi / DeepSeek session to your local web-to-api server.",
  "permissions": [
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://*.qwen.ai/*",
    "https://*.kimi.ai/*",
    "https://*.kimi.com/*",
    "https://*.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this session to web-to-api",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "dashboard-marker.js"
      ],
      "run_at": "document_start"
    }
  ]
}
